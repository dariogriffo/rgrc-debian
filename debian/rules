#!/usr/bin/make -f
DEB_HOST_ARCH ?= $(shell dpkg-architecture -qDEB_HOST_ARCH)
RGRC_VERSION := $(shell dpkg-parsechangelog -S Version | sed 's/[-~].*//')

%:
	dh $@

override_dh_auto_configure:

# The orig tarball is the upstream source; we ship the upstream musl release
# binary instead of compiling it, and take the man page and configs from the tree.
override_dh_auto_build:
	@arch="$(DEB_HOST_ARCH)"; \
	case "$$arch" in \
		amd64) RGRC_RELEASE="rgrc-x86_64-unknown-linux-musl" ;; \
		arm64) RGRC_RELEASE="rgrc-aarch64-unknown-linux-musl" ;; \
		armhf) RGRC_RELEASE="rgrc-arm-unknown-linux-musleabihf" ;; \
		i386)  RGRC_RELEASE="rgrc-i686-unknown-linux-musl" ;; \
		*) echo "Unsupported architecture: $$arch"; exit 1 ;; \
	esac; \
	echo "Downloading $$RGRC_RELEASE for $(RGRC_VERSION)..."; \
	wget -q "https://github.com/lazywalker/rgrc/releases/download/v$(RGRC_VERSION)/$$RGRC_RELEASE.tar.gz"; \
	mkdir -p "$$RGRC_RELEASE"; \
	tar -xf "$$RGRC_RELEASE.tar.gz" -C "$$RGRC_RELEASE"; \
	rm -f "$$RGRC_RELEASE.tar.gz"; \
	test -f "$$RGRC_RELEASE/rgrc" || { echo "rgrc binary missing from $$RGRC_RELEASE"; exit 1; }; \
	mkdir -p debian/completions; \
	"$$RGRC_RELEASE/rgrc" --completions bash > debian/completions/rgrc; \
	"$$RGRC_RELEASE/rgrc" --completions zsh > debian/completions/_rgrc; \
	"$$RGRC_RELEASE/rgrc" --completions fish > debian/completions/rgrc.fish; \
	echo "$$RGRC_RELEASE" > .rgrc_release_name

override_dh_auto_install:
	@RGRC_RELEASE=$$(cat .rgrc_release_name); \
	install -D -m 755 "$$RGRC_RELEASE/rgrc" debian/rgrc/usr/bin/rgrc; \
	install -D -m 644 etc/rgrc.conf debian/rgrc/etc/rgrc.conf; \
	mkdir -p debian/rgrc/usr/share/rgrc; \
	install -m 644 share/conf.* debian/rgrc/usr/share/rgrc/; \
	install -D -m 644 doc/rgrc.1 debian/rgrc/usr/share/man/man1/rgrc.1; \
	install -D -m 644 debian/completions/rgrc debian/rgrc/usr/share/bash-completion/completions/rgrc; \
	install -D -m 644 debian/completions/rgrc.fish debian/rgrc/usr/share/fish/vendor_completions.d/rgrc.fish; \
	install -D -m 644 debian/completions/_rgrc debian/rgrc/usr/share/zsh/vendor-completions/_rgrc

override_dh_auto_test:

override_dh_auto_clean:
	@if [ -f .rgrc_release_name ]; then \
		RGRC_RELEASE=$$(cat .rgrc_release_name); \
		rm -rf "$$RGRC_RELEASE" .rgrc_release_name || true; \
	fi
	rm -rf debian/completions

override_dh_strip:

override_dh_dwz:

override_dh_shlibdeps:
